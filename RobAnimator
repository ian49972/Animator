local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local EasingStyleMap = {
	[Enum.PoseEasingStyle.Linear] = Enum.EasingStyle.Linear,
	[Enum.PoseEasingStyle.Bounce] = Enum.EasingStyle.Bounce,
	[Enum.PoseEasingStyle.Cubic] = Enum.EasingStyle.Cubic,
	[Enum.PoseEasingStyle.Elastic] = Enum.EasingStyle.Elastic,
	[Enum.PoseEasingStyle.Constant] = Enum.EasingStyle.Linear,
}

local EasingDirectionMap = {
	[Enum.PoseEasingDirection.In] = Enum.EasingDirection.In,
	[Enum.PoseEasingDirection.Out] = Enum.EasingDirection.Out,
	[Enum.PoseEasingDirection.InOut] = Enum.EasingDirection.InOut,
}

local PriorityValue = {
	[Enum.AnimationPriority.Core] = 0,
	[Enum.AnimationPriority.Idle] = 1,
	[Enum.AnimationPriority.Movement] = 2,
	[Enum.AnimationPriority.Action] = 3,
	[Enum.AnimationPriority.Action2] = 4,
	[Enum.AnimationPriority.Action3] = 5,
	[Enum.AnimationPriority.Action4] = 6,
}

local RigControllers = {}
local AnimationCache = {}

local function DestroyExistingAnimator(model)
	if not model then
		return
	end

	local anim = model:FindFirstChildWhichIsA("Animator")

	if anim then
		anim:Destroy()
		return
	end

	local hum = model:FindFirstChildOfClass("Humanoid")

	if hum then
		anim = hum:FindFirstChildWhichIsA("Animator")

		if anim then
			anim:Destroy()
			return
		end
	end

	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("Animator") then
			desc:Destroy()
			return
		end
	end
end

local function AddJointToRegistry(controller, joint)
	if not joint then
		return
	end

	local name

	if joint:IsA("Motor6D") then
		if not joint.Part1 then
			return
		end

		name = joint.Part1.Name
	elseif joint:IsA("Bone") then
		name = joint.Name
	else
		return
	end

	local list = controller.JointRegistry[name]

	if not list then
		list = {}
		controller.JointRegistry[name] = list
	end

	list[joint] = true
end

local function RemoveJointFromRegistry(controller, joint)
	if not joint then
		return
	end

	local name

	if joint:IsA("Motor6D") then
		if joint.Part1 then
			name = joint.Part1.Name
		end
	elseif joint:IsA("Bone") then
		name = joint.Name
	end

	if not name then
		return
	end

	local list = controller.JointRegistry[name]

	if list then
		list[joint] = nil

		if next(list) == nil then
			controller.JointRegistry[name] = nil
		end
	end
end

local function GetBestJoint(controller, name)
	local list = controller.JointRegistry[name]

	if not list then
		return nil, nil
	end

	local fallback
	local fallbackType

	for joint in pairs(list) do
		if joint.Parent then
			if joint:IsA("Motor6D") then
				if joint.Part1 and joint.Part1.Name == name then
					return joint, "Motor6D"
				end
			elseif joint:IsA("Bone") and joint.Name == name then
				fallback = joint
				fallbackType = "Bone"
			end
		else
			list[joint] = nil
		end
	end

	if fallback then
		return fallback, fallbackType
	end

	if next(list) == nil then
		controller.JointRegistry[name] = nil
	end

	return nil, nil
end

local function BindJointData(controller, jointData)
	for jointName, data in pairs(jointData) do
		local joint, jtype = GetBestJoint(controller, jointName)

		data.joint = joint
		data.jtype = jtype
	end
end

local function FindPoseIndex(poses, timePosition, currentIndex)
	local count = #poses

	if count <= 1 then
		return 1
	end

	currentIndex = currentIndex or 1

	if currentIndex < 1 then
		currentIndex = 1
	elseif currentIndex >= count then
		currentIndex = count - 1
	end

	if timePosition >= poses[currentIndex].time
		and timePosition < poses[currentIndex + 1].time then
		return currentIndex
	end

	if timePosition >= poses[currentIndex].time then
		while currentIndex < count - 1
			and timePosition >= poses[currentIndex + 1].time do
			currentIndex += 1
		end

		return currentIndex
	end

	while currentIndex > 1
		and timePosition < poses[currentIndex].time do
		currentIndex -= 1
	end

	return currentIndex
end

local function FireTimelineEntry(track, keyframe)
	-- KeyframeReached follows Roblox's behavior: ordinary keyframes named
	-- "Keyframe" are ignored, while renamed keyframes report their name.
	if keyframe.name ~= "Keyframe" and track._keyframeReachedEvent then
		track._keyframeReachedEvent:Fire(keyframe.name)
	end

	for _, marker in ipairs(keyframe.markers) do
		local signal = track._markerSignals[marker.name]

		if signal then
			signal:Fire(marker.value)
		end
	end
end

local function FireTimelineEventsAtTime(track, timePosition)
	for _, keyframe in ipairs(track._keyframes) do
		if keyframe.time == timePosition then
			FireTimelineEntry(track, keyframe)
		elseif keyframe.time > timePosition then
			break
		end
	end
end

local function FireTimelineEventsBetween(track, fromTime, toTime)
	if fromTime == toTime or #track._keyframes == 0 then
		return
	end

	local length = track.Length
	local forward = toTime > fromTime
	local looped = track.Looped and length > 0
	local occurrences = {}

	for order, keyframe in ipairs(track._keyframes) do
		local firstCycle = 0
		local lastCycle = -1

		if looped then
			if forward then
				firstCycle = math.floor((fromTime - keyframe.time) / length) + 1
				lastCycle = math.floor((toTime - keyframe.time) / length)
			else
				firstCycle = math.ceil((toTime - keyframe.time) / length)
				lastCycle = math.ceil((fromTime - keyframe.time) / length) - 1
			end
		else
			firstCycle = 0
			lastCycle = 0
		end

		for cycle = firstCycle, lastCycle do
			local occurrence = keyframe.time + cycle * length
			local crossed

			if forward then
				crossed = occurrence > fromTime and occurrence <= toTime
			else
				crossed = occurrence >= toTime and occurrence < fromTime
			end

			if crossed then
				table.insert(occurrences, {
					position = occurrence;
					keyframe = keyframe;
					order = order;
				})
			end
		end
	end

	table.sort(occurrences, function(a, b)
		if a.position ~= b.position then
			if forward then
				return a.position < b.position
			end

			return a.position > b.position
		end

		-- At a loop boundary, the end keyframe is reached before the next
		-- cycle's time-zero keyframe (and in the opposite order in reverse).
		if a.keyframe.time ~= b.keyframe.time then
			if forward then
				return a.keyframe.time > b.keyframe.time
			end

			return a.keyframe.time < b.keyframe.time
		end

		return a.order < b.order
	end)

	for _, occurrence in ipairs(occurrences) do
		FireTimelineEntry(track, occurrence.keyframe)
	end
end

local function GetOrCreateController(model)
	if RigControllers[model] then
		return RigControllers[model]
	end

	local controller = {
		Tracks = {};
		JointRegistry = {};
		Outputs = {};
	}

	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("Motor6D") or desc:IsA("Bone") then
			AddJointToRegistry(controller, desc)
		end
	end

	controller.DescendantAddedConnection = model.DescendantAdded:Connect(function(desc)
		if not desc:IsA("Motor6D") and not desc:IsA("Bone") then
			return
		end

		AddJointToRegistry(controller, desc)

		local name

		if desc:IsA("Motor6D") then
			if desc.Part1 then
				name = desc.Part1.Name
			end
		else
			name = desc.Name
		end

		if not name then
			return
		end

		local joint, jtype = GetBestJoint(controller, name)

		if joint then
			for _, track in ipairs(controller.Tracks) do
				local data = track._jointData and track._jointData[name]

				if data then
					data.joint = joint
					data.jtype = jtype
				end
			end
		end
	end)

	controller.DescendantRemovingConnection = model.DescendantRemoving:Connect(function(desc)
		if not desc:IsA("Motor6D") and not desc:IsA("Bone") then
			return
		end

		local name

		if desc:IsA("Motor6D") then
			if desc.Part1 then
				name = desc.Part1.Name
			end
		else
			name = desc.Name
		end

		RemoveJointFromRegistry(controller, desc)

		if not name then
			return
		end

		local joint, jtype = GetBestJoint(controller, name)

		for _, track in ipairs(controller.Tracks) do
			local data = track._jointData and track._jointData[name]

			if data then
				data.joint = joint
				data.jtype = jtype
			end
		end
	end)

	controller.Connection = RunService.Heartbeat:Connect(function()
		if not model or not model.Parent then
			controller.Connection:Disconnect()

			if controller.DescendantAddedConnection then
				controller.DescendantAddedConnection:Disconnect()
			end

			if controller.DescendantRemovingConnection then
				controller.DescendantRemovingConnection:Disconnect()
			end

			RigControllers[model] = nil
			return
		end

		local now = os.clock()

		for _, track in ipairs(controller.Tracks) do
			if track.IsPlaying then
				if track._pendingStartEvent then
					track._pendingStartEvent = false
					FireTimelineEventsAtTime(track, track._timePosition)
				end

				local speed = track.Speed or 1
				local delta = (now - track._lastUpdateClock) * speed
				local previousTime = track._timePosition
				local nextTime = previousTime + delta
				track._lastUpdateClock = now

				if track.Looped and track.Length > 0 then
					FireTimelineEventsBetween(track, previousTime, nextTime)
					track._timePosition = nextTime % track.Length

					if nextTime >= track.Length or nextTime < 0 then
						for _, data in pairs(track._jointData) do
							data.index = 1
						end
					end
				elseif not track.Looped and nextTime >= track.Length then
					FireTimelineEventsBetween(
						track,
						previousTime,
						track.Length
					)
					track._timePosition = track.Length
					track.IsPlaying = false
				elseif not track.Looped and nextTime <= 0 then
					FireTimelineEventsBetween(track, previousTime, 0)
					track._timePosition = 0

					if delta < 0 then
						track.IsPlaying = false
					end
				else
					FireTimelineEventsBetween(track, previousTime, nextTime)
					track._timePosition = nextTime
				end
			end
		end

		for _, track in ipairs(controller.Tracks) do
			if not track.IsPlaying then
				continue
			end

			local trackWeight = track.Weight or 1

			if trackWeight <= 0 then
				continue
			end

			local timePosition = track._timePosition
			local trackPriority = PriorityValue[track.Priority] or 3

			for jointName, data in pairs(track._jointData) do
				local poses = data.poses
				local count = #poses

				if count == 0 then
					continue
				end

				local joint = data.joint

				if not joint or not joint.Parent then
					local newJoint, newType = GetBestJoint(
						controller,
						jointName
					)

					data.joint = newJoint
					data.jtype = newType

					joint = newJoint
				end

				if not joint or not joint.Parent then
					continue
				end

				local lastPose
				local nextPose
				local alpha

				if count == 1 then
					lastPose = poses[1]
					nextPose = poses[1]
					alpha = 0
				else
					local index = FindPoseIndex(
						poses,
						timePosition,
						data.index
					)

					data.index = index

					lastPose = poses[index]
					nextPose = poses[math.min(index + 1, count)]

					if lastPose == nextPose then
						alpha = 0
					else
						local duration = nextPose.time - lastPose.time

						if duration > 0 then
							alpha = (
								timePosition - lastPose.time
							) / duration
						else
							alpha = 0
						end

						alpha = math.clamp(alpha, 0, 1)
					end
				end

				local finalCF

				if lastPose == nextPose then
					finalCF = lastPose.cframe
				else
					local eased = alpha

					if alpha > 0 and alpha < 1 then
						eased = TweenService:GetValue(
							alpha,
							nextPose.easingStyle,
							nextPose.easingDirection
						)
					end

					finalCF = lastPose.cframe:Lerp(
						nextPose.cframe,
						eased
					)
				end

				local previous = controller.Outputs[joint]

				if not previous then
					controller.Outputs[joint] = {
						priority = trackPriority;
						weight = trackWeight;
						cframe = finalCF;
						jtype = data.jtype;
					}
				elseif trackPriority > previous.priority then
					controller.Outputs[joint] = {
						priority = trackPriority;
						weight = trackWeight;
						cframe = finalCF;
						jtype = data.jtype;
					}
				elseif trackPriority == previous.priority then
					local totalWeight =
						previous.weight + trackWeight

					if totalWeight > 0 then
						local blendAlpha =
							trackWeight / totalWeight

						previous.cframe =
							previous.cframe:Lerp(
								finalCF,
								blendAlpha
							)

						previous.weight = totalWeight
					end
				end
			end
		end

		for joint, output in pairs(controller.Outputs) do
			if joint.Parent then
				joint.Transform = output.cframe
			end
		end

		table.clear(controller.Outputs)
	end)

	RigControllers[model] = controller

	return controller
end

local function BuildAnimationData(KeyframeSequence)
	local cached = AnimationCache[KeyframeSequence]

	if cached then
		local jointData = {}

		for jointName, cachedPoses in pairs(cached.Data) do
			local poses = table.create(#cachedPoses)

			for i, pose in ipairs(cachedPoses) do
				poses[i] = {
					time = pose.time;
					cframe = pose.cframe;
					easingStyle = pose.easingStyle;
					easingDirection = pose.easingDirection;
				}
			end

			jointData[jointName] = {
				poses = poses;
				index = 1;
				joint = nil;
				jtype = nil;
			}
		end

		return cached.Length, jointData, cached.Keyframes or {}
	end

	local keyframes = KeyframeSequence:GetKeyframes()

	if #keyframes == 0 then
		return nil, nil
	end

	local originalOrder = {}

	for index, keyframe in ipairs(keyframes) do
		originalOrder[keyframe] = index
	end

	table.sort(keyframes, function(a, b)
		if a.Time == b.Time then
			return originalOrder[a] < originalOrder[b]
		end

		return a.Time < b.Time
	end)

	local rawLength = keyframes[#keyframes].Time
	local jointData = {}
	local timelineKeyframes = table.create(#keyframes)

	for _, keyframe in ipairs(keyframes) do
		local markers = {}

		for _, marker in ipairs(keyframe:GetDescendants()) do
			if marker:IsA("KeyframeMarker") then
				markers[#markers + 1] = {
					name = marker.Name;
					value = marker.Value;
				}
			end
		end

		timelineKeyframes[#timelineKeyframes + 1] = {
			name = keyframe.Name;
			time = keyframe.Time;
			markers = markers;
		}
	end

	for _, keyframe in ipairs(keyframes) do
		local time = keyframe.Time

		for _, pose in ipairs(keyframe:GetDescendants()) do
			if pose:IsA("Pose") and pose.Weight > 0 then
				local data = jointData[pose.Name]

				if not data then
					data = {
						poses = {};
						index = 1;
						joint = nil;
						jtype = nil;
					}

					jointData[pose.Name] = data
				end

				local easingStyle =
					EasingStyleMap[pose.EasingStyle]
					or Enum.EasingStyle.Linear

				local easingDirection =
					EasingDirectionMap[pose.EasingDirection]
					or Enum.EasingDirection.InOut

				data.poses[#data.poses + 1] = {
					time = time;
					cframe = pose.CFrame;
					easingStyle = easingStyle;
					easingDirection = easingDirection;
				}
			end
		end
	end

	local save = {}

	for jointName, data in pairs(jointData) do
		local savedPoses = table.create(#data.poses)

		for i, pose in ipairs(data.poses) do
			savedPoses[i] = {
				time = pose.time;
				cframe = pose.cframe;
				easingStyle = pose.easingStyle;
				easingDirection = pose.easingDirection;
			}
		end

		save[jointName] = savedPoses
	end

	AnimationCache[KeyframeSequence] = {
		Length = rawLength;
		Data = save;
		Keyframes = timelineKeyframes;
	}

	return rawLength, jointData, timelineKeyframes
end

local function PlayKeyframeSequence(Model, KeyframeSequence, SpeedMult)
	SpeedMult = SpeedMult or 1

	if not Model or not KeyframeSequence then
		return nil
	end

	DestroyExistingAnimator(Model)

	local rawLength, jointData, keyframes =
		BuildAnimationData(KeyframeSequence)

	if not rawLength or not jointData then
		return nil
	end

	local controller = GetOrCreateController(Model)

	BindJointData(controller, jointData)

	local keyframeReachedEvent = Instance.new("BindableEvent")

	local track = {
		Length = rawLength;
		Weight = 1;
		Priority = Enum.AnimationPriority.Action;
		Looped = true;
		IsPlaying = true;
		Speed = SpeedMult;
		Model = Model;
		KeyframeReached = keyframeReachedEvent.Event;
		_jointData = jointData;
		_keyframes = keyframes or {};
		_keyframeReachedEvent = keyframeReachedEvent;
		_markerSignals = {};
		_pendingStartEvent = true;
		_timePosition = 0;
		_lastUpdateClock = os.clock();

		Play = function(self, speed)
			if speed ~= nil then
				self.Speed = speed
			end

			if not self.IsPlaying then
				self.IsPlaying = true
				self._lastUpdateClock = os.clock()
			end
		end;

		Stop = function(self)
			self.IsPlaying = false
		end;

		AdjustSpeed = function(self, newSpeed)
			self.Speed = newSpeed or 1
		end;

		SetTimePosition = function(self, t)
			self._timePosition = math.clamp(
				t or 0,
				0,
				self.Length
			)

			for _, data in pairs(self._jointData) do
				data.index = 1
			end

			self._lastUpdateClock = os.clock()
		end;

		GetTimePosition = function(self)
			return self._timePosition
		end;

		GetMarkerReachedSignal = function(self, markerName)
			if type(markerName) ~= "string" then
				error("markerName must be a string", 2)
			end

			local signal = self._markerSignals[markerName]

			if not signal then
				signal = Instance.new("BindableEvent")
				self._markerSignals[markerName] = signal
			end

			return signal.Event
		end;

		GetTimeOfKeyframe = function(self, keyframeName)
			if type(keyframeName) ~= "string" then
				error("keyframeName must be a string", 2)
			end

			for _, keyframe in ipairs(self._keyframes) do
				if keyframe.name == keyframeName then
					return keyframe.time
				end
			end

			return nil
		end;

		GetKeyframeName = function(self, timePosition)
			local position = timePosition

			if position == nil then
				position = self._timePosition
			end

			local previousKeyframe

			for _, keyframe in ipairs(self._keyframes) do
				if keyframe.time <= position then
					previousKeyframe = keyframe
				else
					break
				end
			end

			return previousKeyframe and previousKeyframe.name or nil
		end;

		GetKeyframeNames = function(self)
			local names = table.create(#self._keyframes)

			for index, keyframe in ipairs(self._keyframes) do
				names[index] = keyframe.name
			end

			return names
		end;

		Destroy = function(self)
			self.IsPlaying = false

			for index, existingTrack in ipairs(controller.Tracks) do
				if existingTrack == self then
					table.remove(controller.Tracks, index)
					break
				end
			end

			if self._keyframeReachedEvent then
				self._keyframeReachedEvent:Destroy()
				self._keyframeReachedEvent = nil
			end

			for _, signal in pairs(self._markerSignals) do
				signal:Destroy()
			end

			table.clear(self._markerSignals)
		end;

		RestoreAnimator = function(self)
			local m = self.Model

			if not m then
				return nil
			end

			local existing =
				m:FindFirstChildWhichIsA("Animator")

			if existing then
				return existing
			end

			local hum =
				m:FindFirstChildOfClass("Humanoid")

			if hum then
				existing =
					hum:FindFirstChildWhichIsA("Animator")

				if existing then
					return existing
				end
			end

			local animator = Instance.new("Animator")
			animator.Parent = hum or m

			return animator
		end;
	}

	setmetatable(track, {
		__index = function(self, key)
			if key == "TimePosition" then
				return self._timePosition
			end

			return rawget(self, key)
		end;

		__newindex = function(self, key, value)
			if key == "TimePosition" then
				self._timePosition = math.clamp(
					value or 0,
					0,
					self.Length
				)

				for _, data in pairs(self._jointData) do
					data.index = 1
				end

				self._lastUpdateClock = os.clock()
			else
				rawset(self, key, value)
			end
		end;
	})

	table.insert(controller.Tracks, track)

	return track
end

getgenv().PlayKeyframeSequence = PlayKeyframeSequence
getgenv().AdvancedKeyframePlayerLoaded = true
_G.PlayKeyframeSequence = PlayKeyframeSequence
