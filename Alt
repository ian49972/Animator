--[[
USAGE EXAMPLE:

local Animator = LoadAnimation(workspace.Dummy, game.ReplicatedStorage:WaitForChild("YourKeyframeSequence"))

Animator:Play(0.2, 1)

-- Stop animation
Animator:Stop()

-- Change speed
Animator:AdjustSpeed(2)

-- Detect keyframes
Animator.KeyframeReached:Connect(function(name)
	print("Reached:", name)
end)

-- Detect completion
Animator.Completed:Connect(function()
	print("Animation finished")
end)
]]

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local function Contains(Table, Check)
	for Index, Value in next, Table do 
		if rawequal(Check, Index) or rawequal(Check, Value) then 
			return true
		end
	end
	return false
end

local function EditJoint(Joint, Change, Duration, Style, Direction, IsMotor)
	Style = Enum.EasingStyle.Linear
	Direction = Enum.EasingDirection.InOut

	local goal = IsMotor and {Transform = Change} or {CFrame = Change}
	local anim = TweenService:Create(Joint, TweenInfo.new(Duration, Style, Direction), goal)
	anim:Play()
	return anim
end

function LoadAnimation(Rig, KeyframeSequence)
	local Defaults = {}
	local Joints = {}
	local IsMotor = {}

	for _, v in pairs(Rig:GetDescendants()) do
		if v:IsA("Bone") then
			Defaults[v.Name] = v.CFrame
			Joints[v.Name] = v
			IsMotor[v.Name] = false
		elseif v:IsA("Motor6D") then
			Defaults[v.Name] = v.Transform
			Joints[v.Name] = v
			IsMotor[v.Name] = true
		end
	end

	assert(KeyframeSequence:IsA("KeyframeSequence"), "KeyframeSequence Missing!")

	local Class = {}
	Class.Speed = 1
	Class.KeepLast = 0

	local Keyframes = KeyframeSequence:GetKeyframes()
	table.sort(Keyframes, function(a, b) return a.Time < b.Time end)

	Class.Length = Keyframes[#Keyframes].Time

	local function Yield(sec)
		local t = sec * (60 + Class.Length)
		for _ = 1, t, Class.Speed do
			task.wait()
		end
	end

	Class.Stopped = true
	Class.IsPlaying = false
	Class.TimePosition = 0
	Class.Looped = KeyframeSequence.Loop

	local Completion = Instance.new("BindableEvent")
	local Reached = Instance.new("BindableEvent")

	Class.Completed = Completion.Event
	Class.KeyframeReached = Reached.Event

	function Class:Play(FadeIn, Speed)
		if Speed and Speed < 0 then
			Speed += (Speed * 2)
		end

		Class.Speed = Speed or Class.Speed
		Class.Stopped = false
		Class.IsPlaying = true

		task.spawn(function()
			task.wait(1/60)

			if FadeIn then
				Class.TimePosition -= FadeIn
			end

			Class.Completed:Connect(function()
				if Class.Looped then
					Class.TimePosition = 0
				end
			end)

			repeat
				RunService.Heartbeat:Wait()
				Class.TimePosition += (1 * Class.Speed) / (60 * Class.Speed)
			until not Class.IsPlaying or Class.Stopped
		end)

		task.spawn(function()
			if FadeIn then
				task.wait(1/55)

				local frames = Keyframes[1]:GetDescendants()
				for _, pose in pairs(frames) do
					if Contains(Joints, pose.Name) then
						task.spawn(function()
							for _ = 1, 2 do
								EditJoint(
									Joints[pose.Name],
									Defaults[pose.Name] * pose.CFrame,
									FadeIn,
									pose.EasingStyle,
									pose.EasingDirection,
									IsMotor[pose.Name]
								)
								task.wait()
							end
						end)
					end
				end

				Yield(FadeIn)
			end

			repeat
				for k = 1, #Keyframes do
					local K0 = Keyframes[k-1]
					local K1 = Keyframes[k]
					local K2 = Keyframes[k+1]

					if not Class.Stopped then
						if K0 then
							Yield(K1.Time - K0.Time)
						end

						for _, pose in pairs(K1:GetDescendants()) do
							if Contains(Joints, pose.Name) then
								local duration = K2 and (K2.Time - K1.Time) / Class.Speed or 0.5

								EditJoint(
									Joints[pose.Name],
									Defaults[pose.Name] * pose.CFrame,
									duration,
									pose.EasingStyle,
									pose.EasingDirection,
									IsMotor[pose.Name]
								)
							end
						end

						if k == #Keyframes and Class.KeepLast > 0 then
							Yield(Class.KeepLast)
						end

						Reached:Fire(K1.Name)
					else
						break
					end
				end

				Completion:Fire()
			until not Class.Looped or Class.Stopped

			Class.IsPlaying = false
		end)
	end

	function Class:Stop()
		Class.Stopped = true
	end

	function Class:AdjustSpeed(Speed)
		if Speed < 0 then
			Speed += (Speed * 2)
		end
		Class.Speed = Speed or Class.Speed
	end

	return Class
end
