--[[
	Usage Example:
	
	local Animator = loadstring(game:HttpGet("PASTE_THE_FULL_SCRIPT_HERE"))()
	
	local Rig = workspace.YourRig
	local KeyframeSequence = game.ReplicatedStorage.YourKeyframeSequence
	
	local anim = Animator:LoadAnimation(Rig, KeyframeSequence)
	
	anim:Play()                    -- normal play
	-- anim:Play(0.5)              -- fade in time in seconds
	-- anim:Play(0, 1.5)           -- fade in, custom speed
	-- anim:AdjustSpeed(2)
	-- anim:Stop()
	
	anim.Completed:Connect(function() print("Animation finished") end)
	anim.KeyframeReached:Connect(function(name) print("Reached:", name) end)
]]

local Animator = {}

local function Contains(Table, Check)
	for Index, Value in next, Table do 
		if rawequal(Check, Index) or rawequal(Check, Value) then 
			return true
		end
	end
	return false
end

local function Edit(Joint, TargetCFrame, Duration, Style, Direction)
	Style = Style or Enum.EasingStyle.Linear
	Direction = Direction or Enum.EasingDirection.InOut
	
	local Property = Joint:IsA("Motor6D") and "Transform" or "CFrame"
	
	local TweenInfo = TweenInfo.new(Duration, Style, Direction)
	local Goal = {[Property] = TargetCFrame}
	
	local Anim = game:GetService("TweenService"):Create(Joint, TweenInfo, Goal)
	Anim:Play()
	return Anim
end

function Animator:LoadAnimation(Rig, KeyframeSequence)
	local AnimDefaults = {}
	local Joints = {}
	
	for _, v in pairs(Rig:GetDescendants()) do
		if v:IsA("Bone") or v:IsA("Motor6D") then
			-- Store default pose
			if v:IsA("Motor6D") then
				AnimDefaults[v.Name] = v.Transform
			else
				AnimDefaults[v.Name] = v.CFrame
			end
			Joints[v.Name] = v
		end
	end
	
	assert(KeyframeSequence:IsA("KeyframeSequence"), "KeyframeSequence Missing!")
	
	local Class = {}
	Class.Speed = 1
	Class.KeepLast = 0
	
	local Keyframes = KeyframeSequence:GetKeyframes()
	table.sort(Keyframes, function(a, b) return a.Time < b.Time end)
	
	Class.Length = Keyframes[#Keyframes].Time
	
	Class.Stopped = true
	Class.IsPlaying = false
	Class.TimePosition = 0
	Class.Looped = KeyframeSequence.Loop
	
	local Completion = Instance.new("BindableEvent")
	local Reached = Instance.new("BindableEvent")
	Class.Completed = Completion.Event
	Class.KeyframeReached = Reached.Event
	
	Class["Play"] = function(self, FadeIn, Speed)
		if Speed and Speed < 0 then
			Speed = Speed + (Speed * 2)
		end
		Class.Speed = Speed or Class.Speed
		Class.Stopped = false
		Class.IsPlaying = true
		
		task.spawn(function()
			task.wait(1/60)
			if FadeIn ~= nil then
				Class.TimePosition -= FadeIn
			end
			repeat
				game:GetService("RunService").Heartbeat:Wait()
				Class.TimePosition += Class.Speed / 60
			until not Class.IsPlaying or Class.Stopped
		end)
		
		task.spawn(function()
			local function Yield(Seconds)
				if Seconds <= 0 then return end
				local Time = Seconds * 60
				for i = 1, Time, Class.Speed do
					task.wait()
				end
			end
			
			if FadeIn ~= nil then
				task.wait(1/55)
				local FirstKeyframe = Keyframes[1]
				for _, Pose in pairs(FirstKeyframe:GetDescendants()) do
					if Pose:IsA("Pose") and Contains(Joints, Pose.Name) then
						local Joint = Joints[Pose.Name]
						local Default = AnimDefaults[Pose.Name]
						local Target = Default * Pose.CFrame
						task.spawn(function()
							Edit(Joint, Target, FadeIn, Pose.EasingStyle, Pose.EasingDirection)
						end)
					end
				end
				Yield(FadeIn)
			end
			
			repeat
				for K = 1, #Keyframes do
					local K0 = Keyframes[K-1]
					local K1 = Keyframes[K]
					local K2 = Keyframes[K+1]
					
					if Class.Stopped then break end
					
					if K0 then
						Yield(K1.Time - K0.Time)
					end
					
					task.spawn(function()
						for _, Pose in pairs(K1:GetDescendants()) do
							if Pose:IsA("Pose") and Contains(Joints, Pose.Name) then
								local Joint = Joints[Pose.Name]
								local Default = AnimDefaults[Pose.Name]
								local Target = Default * Pose.CFrame
								local Duration = K2 and (K2.Time - K1.Time) / Class.Speed or 0.3
								
								Edit(Joint, Target, Duration, Pose.EasingStyle, Pose.EasingDirection)
							end
						end
					end)
					
					if K == #Keyframes and Class.KeepLast > 0 then
						Yield(Class.KeepLast)
					end
					
					Reached:Fire(K1.Name)
				end
				
				Completion:Fire()
			until not Class.Looped or Class.Stopped
			
			Class.IsPlaying = false
		end)
	end
	
	Class["Stop"] = function()
		Class.Stopped = true
	end
	
	Class["AdjustSpeed"] = function(self, Speed)
		if Speed and Speed < 0 then
			Speed = Speed + (Speed * 2)
		end
		Class.Speed = Speed or Class.Speed
	end
	
	return Class
end

return Animator
